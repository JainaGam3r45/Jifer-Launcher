# Copy this file to .env for local development.
# Keep real credentials and machine-specific paths out of version control.

# Microsoft premium sign-in. Create a public/native Microsoft Entra app with device code flow enabled.
# Debug builds read this at runtime; release builds get it from CI at compile time.
MICROSOFT_CLIENT_ID=

# Log filter for the launcher (tracing EnvFilter syntax), e.g. "info" or "jifercraft_core=debug".
JIFERCRAFT_LOG=info

# Optional: use this folder instead of the platform .jifercloud directory (portable installs, testing).
JIFERCRAFT_DATA_DIR=
